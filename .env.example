# Copy values into your environment or a local .env (not committed).
# Used mainly by the prod profile; local profile has defaults in application-local.yml.

SPRING_PROFILES_ACTIVE=local

# Postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stockly
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Redis (optional — app starts without it)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# JWT — use a long random string in prod
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# CORS (comma-separated). Local UI is Vite on 5173.
STOCKLY_CORS_ORIGINS=http://localhost:5173
